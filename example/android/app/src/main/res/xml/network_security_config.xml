<?xml version="1.0" encoding="utf-8"?>
<!-- 仅在 debug 包中信任用户安装的证书，方便 Charles 等工具抓包；release 包保持系统默认安全策略 -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
